{"id": "n01", "type": "numeric", "question": "I went through halfway in 1:42 and 10 km in 47:30. What finish should I expect, and how likely am I to hit the wall?", "relevant_cards": ["hitting-the-wall", "negative-split-reality"], "let": [{"name": "p", "tool": "predict_finish", "args": {"splits": {"10": 47.5, "21": 102}, "gender": null, "age": null}}], "targets": [{"key": "finish_min", "unit": "minutes", "value": "=p['median_min']", "tol": "=tol_finish(p)"}, {"key": "wall_risk_pct", "unit": "percent", "value": "=p['wall_risk']*100", "tol": "=TOL_PROB"}]}
{"id": "n02", "type": "numeric", "question": "My splits were 25:10 at 5 km, 50:05 at 10 km, 1:15:20 at 15 km and 1:40:40 at 20 km. I'm a 45-year-old woman. What's my projected finish time, and what's the 80% range around it?", "relevant_cards": ["hitting-the-wall"], "let": [{"name": "p", "tool": "predict_finish", "args": {"splits": {"5": 25.166666666666668, "10": 50.083333333333336, "15": 75.33333333333333, "20": 100.66666666666667}, "gender": "F", "age": 45}}], "targets": [{"key": "finish_min", "unit": "minutes", "value": "=p['median_min']", "tol": "=tol_finish(p)"}, {"key": "finish_lo80_min", "unit": "minutes", "value": "=p['lo80_min']", "tol": "=tol_finish(p)"}, {"key": "finish_hi80_min", "unit": "minutes", "value": "=p['hi80_min']", "tol": "=tol_finish(p)"}]}
