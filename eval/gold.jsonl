{"id": "c02", "type": "numeric", "question": "I hit halfway in 1:50 and 10 km in 52:00. What even pace per kilometer for the rest of the race would match the finish time the model predicts for me?", "relevant_cards": ["hitting-the-wall", "even-pacing-strategy"], "let": [{"name": "p", "tool": "predict_finish", "args": {"splits": {"10": 52.0, "21": 110.0}, "gender": null, "age": null}}], "targets": [{"key": "finish_min", "unit": "minutes", "value": "=p['median_min']", "tol": "=tol_finish(p)"}, {"key": "pace_sec_per_km", "unit": "seconds per km", "value": "=(p['median_min']-110)*60/(42.195-21.0975)", "tol": "=max(TOL_PACE, tol_finish(p)*60/(42.195-21.0975))"}]}
{"id": "k01", "type": "numeric", "question": "I weigh 65 kg. Using the standard carb-loading guideline, how many grams of carbohydrate per day should I eat in the final days before the race (low and high end)?", "relevant_cards": ["carb-loading"], "let": [], "targets": [{"key": "carbs_lo_g_per_day", "unit": "grams", "value": "=fact('carb_load_g_per_kg_lo')*65", "tol": "=tol_card(fact('carb_load_g_per_kg_lo')*65)"}, {"key": "carbs_hi_g_per_day", "unit": "grams", "value": "=fact('carb_load_g_per_kg_hi')*65", "tol": "=tol_card(fact('carb_load_g_per_kg_hi')*65)"}]}
